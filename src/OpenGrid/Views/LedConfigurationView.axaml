<UserControl
    x:Class="OpenGrid.Views.LedConfigurationView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:OpenGrid.ViewModels"
    x:DataType="vm:LedConfigurationViewModel">

    <StackPanel Spacing="16">

        <TextBlock
            Classes="Subtitle1"
            Text="LED Effects" />

        <TextBlock
            Classes="Caption"
            Opacity="0.6"
            Text="Each frame defines the exact colour of every LED at a given percentage of the car's redline. The last frame whose threshold has been reached wins. Set an LED to black to turn it off. Flicker blinks the whole frame. Presets work with any device that supports LED effects; frames are resized to the device's LED count."
            TextWrapping="Wrap" />

        <Grid ColumnDefinitions="140,*" ColumnSpacing="12">
            <TextBlock
                Grid.Column="0"
                VerticalAlignment="Center"
                Classes="Subtitle1"
                Opacity="0.6"
                Text="LEDs per frame" />
            <ComboBox
                Grid.Column="1"
                MinWidth="100"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                ItemsSource="{Binding LedCountOptions}"
                SelectedItem="{Binding LedCount}" />
        </Grid>

        <Grid
            ColumnDefinitions="36,*,100,80,90"
            ColumnSpacing="8">
            <TextBlock
                Grid.Column="0"
                Classes="Caption"
                Opacity="0.6"
                Text="Frame" />
            <TextBlock
                Grid.Column="1"
                Classes="Caption"
                Opacity="0.6"
                Text="LED pattern" />
            <TextBlock
                Grid.Column="2"
                Classes="Caption"
                Opacity="0.6"
                Text="% redline" />
            <TextBlock
                Grid.Column="3"
                Classes="Caption"
                Opacity="0.6"
                Text="Flicker" />
            <TextBlock
                Grid.Column="4"
                Classes="Caption"
                Opacity="0.6"
                Text="Action" />
        </Grid>

        <ItemsControl ItemsSource="{Binding Segments}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RpmLedSegmentViewModel">
                    <Grid
                        Margin="0,0,0,8"
                        ColumnDefinitions="36,*,100,80,90"
                        ColumnSpacing="8">
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Classes="Body2"
                            Text="{Binding Index, StringFormat='{}{0}.'}" />

                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Leds}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RpmLedCellViewModel">
                                    <ColorPicker
                                        Width="24"
                                        Height="24"
                                        MinWidth="24"
                                        Margin="0"
                                        HorizontalAlignment="Center"
                                        CornerRadius="4"
                                        IsAlphaEnabled="False"
                                        ToolTip.Tip="Black turns this LED off"
                                        Color="{Binding Color, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBox
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Text="{Binding ThresholdPercentText, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            IsChecked="{Binding Flicker}" />
                        <Button
                            Grid.Column="4"
                            Padding="8,4"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Command="{Binding RemoveCommand}"
                            Content="Remove" />
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button
            Padding="12,6"
            HorizontalAlignment="Left"
            Command="{Binding AddSegmentCommand}"
            Content="Add frame" />

    </StackPanel>
</UserControl>
