<UserControl
    x:Class="OpenGrid.Views.RpmLedEffectView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:vm="using:OpenGrid.ViewModels"
    x:DataType="vm:RpmLedEffectViewModel">

    <StackPanel Spacing="10">
        <TextBlock
            Classes="Caption"
            Opacity="0.6"
            Text="Each frame defines the exact colour of every LED at a given percentage of the car's redline. The last frame whose threshold has been reached wins. Set an LED to black to turn it off. Flicker blinks the whole frame. Frames are resized to the device's LED count."
            TextWrapping="Wrap" />

        <Grid ColumnDefinitions="36,*,60,60,72" ColumnSpacing="8">
            <TextBlock
                Grid.Column="0"
                Classes="Caption"
                Opacity="0.6"
                Text="Frame" />
            <TextBlock
                Grid.Column="1"
                Classes="Caption"
                Opacity="0.6"
                Text="LED pattern" />
            <TextBlock
                Grid.Column="2"
                Classes="Caption"
                Opacity="0.6"
                Text="% redline" />
            <TextBlock
                Grid.Column="3"
                Classes="Caption"
                Opacity="0.6"
                Text="Flicker" />
            <TextBlock
                Grid.Column="4"
                Classes="Caption"
                Opacity="0.6"
                Text="Action" />
        </Grid>

        <ItemsControl ItemsSource="{Binding Segments}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:RpmLedSegmentViewModel">
                    <Grid ColumnDefinitions="36,*,60,60,72" ColumnSpacing="8">
                        <TextBlock
                            Grid.Column="0"
                            VerticalAlignment="Center"
                            Classes="Body2"
                            Text="{Binding Index, StringFormat='{}{0}.'}" />

                        <ItemsControl Grid.Column="1" ItemsSource="{Binding Leds}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Orientation="Horizontal" Spacing="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:RpmLedCellViewModel">
                                    <ColorPicker
                                        Width="24"
                                        Height="24"
                                        MinWidth="24"
                                        Margin="0"
                                        HorizontalAlignment="Center"
                                        CornerRadius="4"
                                        IsAlphaEnabled="False"
                                        ToolTip.Tip="Black turns this LED off"
                                        Color="{Binding Color, Mode=TwoWay}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <TextBox
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Text="{Binding ThresholdPercentText, UpdateSourceTrigger=PropertyChanged}" />
                        <CheckBox
                            Grid.Column="3"
                            VerticalAlignment="Center"
                            IsChecked="{Binding Flicker}" />
                        <StackPanel
                            Grid.Column="4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal"
                            Spacing="4">
                            <Button
                                Width="24"
                                Height="24"
                                Padding="0"
                                Classes="Flat"
                                Command="{Binding DuplicateCommand}"
                                ToolTip.Tip="Duplicate frame">
                                <avalonia:MaterialIcon IconSize="16" Kind="ContentDuplicate" />
                            </Button>
                            <Button
                                Width="24"
                                Height="24"
                                Padding="0"
                                Classes="Flat"
                                Command="{Binding RemoveCommand}"
                                ToolTip.Tip="Delete frame">
                                <avalonia:MaterialIcon IconSize="16" Kind="Trash" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>

        <Button
            Padding="12,6"
            HorizontalAlignment="Left"
            Command="{Binding AddSegmentCommand}"
            Content="Add frame" />
    </StackPanel>
</UserControl>
