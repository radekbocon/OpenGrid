<UserControl
    x:Class="OpenGrid.Views.SoundDeviceItemView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:viewModels="clr-namespace:OpenGrid.ViewModels"
    x:DataType="viewModels:SoundDeviceItemViewModel">

    <ScrollViewer>
        <StackPanel Margin="16" Spacing="16">
            <TextBlock Classes="Headline6" Text="Device Details" />

            <Rectangle Height="1" Fill="{DynamicResource MaterialDividerBrush}" />

            <!--  Name  -->
            <Grid
                ColumnDefinitions="140,*"
                ColumnSpacing="12"
                RowDefinitions="Auto">
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Classes="Subtitle1"
                    Opacity="0.6"
                    Text="Name" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Classes="Body1"
                    Text="{Binding Name}" />
            </Grid>

            <!--  Description  -->
            <Grid
                ColumnDefinitions="140,*"
                ColumnSpacing="12"
                RowDefinitions="Auto">
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Classes="Subtitle1"
                    Opacity="0.6"
                    Text="Description" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Classes="Body1"
                    Text="{Binding Description, TargetNullValue='No description'}" />
            </Grid>

            <!--  Status  -->
            <Grid
                ColumnDefinitions="140,*"
                ColumnSpacing="12"
                RowDefinitions="Auto">
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Classes="Subtitle1"
                    Opacity="0.6"
                    Text="Status" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Classes="Body1"
                    Text="{Binding Status}" />
            </Grid>

            <!--  Device ID  -->
            <Grid
                ColumnDefinitions="140,*"
                ColumnSpacing="12"
                RowDefinitions="Auto">
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Classes="Subtitle1"
                    Opacity="0.6"
                    Text="Device ID" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Classes="Body2"
                    Opacity="0.5"
                    Text="{Binding Device?.Id, TargetNullValue='-'}" />
            </Grid>

            <Rectangle Height="1" Fill="{DynamicResource MaterialDividerBrush}" />

            <!--  Configuration  -->
            <TextBlock Classes="Headline6" Text="Bass Shaker" />

            <Rectangle Height="1" Fill="{DynamicResource MaterialDividerBrush}" />

            <!--  Enabled toggle  -->
            <Grid
                ColumnDefinitions="140,*"
                ColumnSpacing="12"
                RowDefinitions="Auto">
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Classes="Subtitle1"
                    Opacity="0.6"
                    Text="Enabled" />
                <ToggleSwitch
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    IsChecked="{Binding IsEnabled}" />
            </Grid>

            <!--  Default preset  -->
            <Grid
                ColumnDefinitions="140,*"
                ColumnSpacing="12"
                RowDefinitions="Auto">
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Classes="Subtitle1"
                    Opacity="0.6"
                    Text="Default Preset" />
                <ComboBox
                    Grid.Column="1"
                    MinWidth="220"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    ItemsSource="{Binding DefaultPresetOptions}"
                    SelectedItem="{Binding SelectedDefaultPreset}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="viewModels:BassShakerPresetOption">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <TextBlock
                Classes="Body2"
                Opacity="0.5"
                Text="Presets are created and edited on the Bass Shaker page."
                TextWrapping="Wrap" />

            <Rectangle Height="1" Fill="{DynamicResource MaterialDividerBrush}" />

            <!--  Game and car overrides  -->
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="2">
                    <TextBlock Classes="Headline6" Text="Game &amp; Car Overrides" />
                    <TextBlock
                        Classes="Body2"
                        Opacity="0.5"
                        Text="The most specific match wins: game + car, then game only, then car only, then the default preset."
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Command="{Binding AddBassShakerOverrideCommand}"
                    Content="Add Override"
                    IsEnabled="{Binding HasPresets}"
                    Theme="{StaticResource MaterialOutlineButton}" />
            </Grid>

            <ItemsControl ItemsSource="{Binding BassShakerOverrides}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="viewModels:BassShakerOverrideItemViewModel">
                        <Border
                            Margin="0,2"
                            Padding="8"
                            Background="{DynamicResource MaterialTextFieldBoxBackgroundBrush}"
                            CornerRadius="4">
                            <Grid
                                ColumnDefinitions="*,*,1.3*,Auto"
                                ColumnSpacing="8">
                                <StackPanel
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock
                                        Classes="Caption"
                                        Opacity="0.5"
                                        Text="Game" />
                                    <TextBlock Text="{Binding GameName}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock
                                        Classes="Caption"
                                        Opacity="0.5"
                                        Text="Car" />
                                    <TextBlock Text="{Binding CarName}" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    Spacing="2">
                                    <TextBlock
                                        Classes="Caption"
                                        Opacity="0.5"
                                        Text="Preset" />
                                    <ComboBox
                                        HorizontalAlignment="Stretch"
                                        ItemsSource="{Binding PresetOptions}"
                                        SelectedItem="{Binding SelectedPreset}">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="viewModels:BassShakerPresetOption">
                                                <TextBlock Text="{Binding Name}" />
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                </StackPanel>
                                <Button
                                    Grid.Column="3"
                                    VerticalAlignment="Bottom"
                                    Command="{Binding RemoveCommand}"
                                    Content="Remove"
                                    Theme="{StaticResource MaterialOutlineButton}" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock
                Classes="Body2"
                IsVisible="{Binding !HasBassShakerOverrides}"
                Opacity="0.5"
                Text="No game or car overrides configured. The default preset will be used."
                TextWrapping="Wrap" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
