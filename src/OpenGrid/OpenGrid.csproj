<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <OutputType>WinExe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <ApplicationManifest>app.manifest</ApplicationManifest>
        <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
        <Version>0.1.1.0</Version>
    </PropertyGroup>

    <ItemGroup>
        <AvaloniaResource Include="Assets\**" />
    <EmbeddedResource Include="Assets\Dashboards\**\*.html" />
    <EmbeddedResource Include="Assets\Dashboards\**\*.json" />
    <EmbeddedResource Include="Assets\Dashboards\**\*.js" />
    <EmbeddedResource Include="Assets\Dashboards\**\*.css" />
    <EmbeddedResource Include="Assets\Dashboards\**\*.png" />
    <EmbeddedResource Include="Assets\Dashboards\**\*.svg" />
    <EmbeddedResource Include="Assets\DashboardFramework\**\*.html" />
    <EmbeddedResource Include="Assets\DashboardFramework\**\*.js" />
    <EmbeddedResource Include="Assets\DashboardFramework\**\*.css" />
    <EmbeddedResource Include="Themes\Default\*.json" />
    <Content Include="Assets\Dashboards\Template\**">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </Content>
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="AsyncImageLoader.Avalonia" Version="3.8.0" />
        <PackageReference Include="Avalonia" Version="12.0.5" />
        <PackageReference Include="Avalonia.Desktop" Version="12.0.5" />
        <PackageReference Include="Avalonia.Fonts.Inter" Version="12.0.5" />
        <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
            <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
            <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
        </PackageReference>
        <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
        <PackageReference Include="CsvHelper" Version="33.1.0" />
        <PackageReference Include="DialogHost.Avalonia" Version="0.12.2" />

        <PackageReference Include="Material.Avalonia" Version="3.17.0" />
        <PackageReference Include="Material.Icons" Version="3.0.3-nightly.0.2" />
        <PackageReference Include="Material.Icons.Avalonia" Version="3.0.3-nightly.0.2" />
        <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="10.0.9" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="ScottPlot.Avalonia" Version="5.1.59" />
        <PackageReference Include="Serilog" Version="4.3.1" />
        <PackageReference Include="Serilog.Sinks.Debug" Version="3.0.0" />
        <PackageReference Include="Serilog.Sinks.File" Version="7.0.0" />
        <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.148.0" />
        <PackageReference Include="System.Reactive" Version="6.1.0" />
        <PackageReference Include="System.IO.Ports" Version="10.0.9" />
        <PackageReference Include="Xaml.Behaviors" Version="12.0.0.1" />
    </ItemGroup>

    <ItemGroup>
      <Compile Update="Controls\ConfirmDialog.axaml.cs">
        <DependentUpon>ConfirmDialog.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Controls\DeviceAccessDialog.axaml.cs">
        <DependentUpon>DeviceAccessDialog.axaml</DependentUpon>
        <SubType>Code</SubType>
      </Compile>
      <Compile Update="Controls\AllSupportedGamesDialog.axaml.cs">
        <DependentUpon>AllSupportedGamesDialog.axaml</DependentUpon>
      </Compile>
      <Compile Update="Controls\AboutDialog.axaml.cs">
        <DependentUpon>AboutDialog.axaml</DependentUpon>
      </Compile>
    </ItemGroup>

    <Target Name="PublishOpenGridBridge" AfterTargets="Build">
        <Exec Command="dotnet publish &quot;$(MSBuildProjectDirectory)\..\OpenGridBridge\OpenGridBridge.csproj&quot; -c $(Configuration) -r win-x64 --output &quot;$(TargetDir)&quot; --nologo" />
    </Target>
</Project>
