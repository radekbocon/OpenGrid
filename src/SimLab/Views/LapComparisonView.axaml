<UserControl
    x:Class="SimLab.Views.LapComparisonView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:controls="clr-namespace:SimLab.Controls"
    xmlns:converters="clr-namespace:SimLab.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:SimLab.ViewModels"
    Padding="16"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:LapComparisonViewModel"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:SkiaColorToBrushConverter x:Key="SkiaColorToBrushConverter" />
        <DataTemplate x:Key="LegendItemTemplate" x:DataType="vm:LapComparisonItem">
            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                <Border
                    Grid.Column="0"
                    Width="24"
                    Height="2"
                    VerticalAlignment="Center"
                    Background="{Binding Color, Converter={StaticResource SkiaColorToBrushConverter}}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Text="{Binding DisplayName}" />
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <ScrollViewer>
        <Grid
            x:Name="ChartGrid"
            Margin="0,0,16,0"
            RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto, Auto, Auto"
            RowSpacing="4">
            <StackPanel
                Grid.Row="0"
                Margin="8"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    VerticalAlignment="Center"
                    Classes="H6"
                    Text="Lap Comparison" />
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <avalonia:MaterialIcon IconSize="24" Kind="Info" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Classes="Caption"
                        Opacity="0.6"
                        Text="Ctrl+Scroll to zoom, drag to pan the charts"
                        TextAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <Border
                Grid.Row="1"
                Margin="8"
                Padding="8"
                CornerRadius="4">
                <StackPanel Spacing="4">
                    <TextBlock Classes="Subtitle2" Text="Compared Laps:" />
                    <ItemsControl ItemTemplate="{StaticResource LegendItemTemplate}" ItemsSource="{Binding SelectedLaps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Spacing="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <controls:ChartControl
                x:Name="GasChart"
                Title="Gas"
                Grid.Row="2"
                SeriesSource="{Binding Gas}"
                YLabeler="{Binding DoubleLabeler}"
                YMaxLimit="1"
                YMinLimit="0" />
            <controls:ChartControl
                x:Name="BrakeChart"
                Title="Brake"
                Grid.Row="3"
                SeriesSource="{Binding Brake}"
                YLabeler="{Binding DoubleLabeler}"
                YMaxLimit="1"
                YMinLimit="0" />
            <controls:ChartControl
                x:Name="SteeringChart"
                Title="Steering"
                Grid.Row="4"
                SeriesSource="{Binding Steering}"
                YLabeler="{Binding DoubleLabeler}"
                YMaxLimit="1"
                YMinLimit="-1" />
            <controls:ChartControl
                x:Name="SpeedChart"
                Title="Speed"
                Grid.Row="5"
                SeriesSource="{Binding Speed}"
                YLabeler="{Binding IntegerLabeler}" />
            <controls:ChartControl
                x:Name="GearChart"
                Title="Gear"
                Grid.Row="6"
                SeriesSource="{Binding Gear}"
                YLabeler="{Binding GearLabeler}"
                YMaxLimit="7"
                YMinLimit="0" />
            <controls:ChartControl
                x:Name="RpmChart"
                Title="RPM"
                Grid.Row="7"
                SeriesSource="{Binding Rpm}"
                YLabeler="{Binding IntegerLabeler}"
                YMinLimit="0" />
        </Grid>
    </ScrollViewer>
</UserControl>
