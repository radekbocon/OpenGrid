<controls:PageView
    x:Class="SimLab.Views.SessionDetailsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:controls="clr-namespace:SimLab.Controls"
    xmlns:controls1="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
    xmlns:converters="clr-namespace:SimLab.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:SimLab.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:SessionDetailsViewModel"
    mc:Ignorable="d">

    <UserControl.Resources>
        <converters:SkiaColorToBrushConverter x:Key="SkiaColorToBrushConverter" />
        <DataTemplate x:Key="LegendItemTemplate" x:DataType="vm:LapComparisonItem">
            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                <Border
                    Grid.Column="0"
                    Width="24"
                    Height="2"
                    VerticalAlignment="Center"
                    Background="{Binding Color, Converter={StaticResource SkiaColorToBrushConverter}}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Classes.FastestLap="{Binding Lap.IsFastest}"
                    Classes.InvalidLap="{Binding !Lap.IsValid}"
                    Text="{Binding DisplayName}" />
            </Grid>
        </DataTemplate>
        <DataTemplate x:Key="ComparisonLapStatsTemplate" x:DataType="vm:LapComparisonItem">
            <controls1:Card>
                <StackPanel Margin="8,4" Spacing="4">
                    <ContentControl Content="{Binding}" ContentTemplate="{StaticResource LegendItemTemplate}" />
                    <controls:LapStatsControl SelectedLap="{Binding Lap}" />
                </StackPanel>
            </controls1:Card>
        </DataTemplate>
    </UserControl.Resources>

    <DockPanel>
        <controls:PageHeader
            Title="{Binding Title}"
            DockPanel.Dock="Top"
            GoBackCommand="{Binding GoBackCommand}">
            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Padding="4" Classes="Flat">
                    <Button.Flyout>
                        <Flyout Placement="BottomEdgeAlignedLeft">
                            <TextBlock
                                MaxWidth="150"
                                Text="Hold Ctrl or the right mouse button while scrolling to zoom the charts and map."
                                TextWrapping="Wrap" />
                        </Flyout>
                    </Button.Flyout>
                    <avalonia:MaterialIcon IconSize="24" Kind="InfoCircleOutline" />
                </Button>
                <Button
                    Padding="4"
                    Classes="Flat"
                    Command="{Binding CompareWithOtherLapsCommand}"
                    IsVisible="{Binding ShowCompareWithOtherLaps}"
                    ToolTip.Tip="Compare with other laps">
                    <avalonia:MaterialIcon IconSize="24" Kind="Compare" />
                </Button>
            </StackPanel>
        </controls:PageHeader>

        <!--  Content  -->
        <ScrollViewer Padding="0,0,12,0">
            <Grid ColumnDefinitions="Auto, *" ColumnSpacing="8">
                <StackPanel
                    Grid.Column="0"
                    IsVisible="{Binding ShowLapDetails}"
                    Spacing="8">
                    <controls1:Card>
                        <controls:LapTableControl
                            DeleteLapCommand="{Binding DeleteLapCommand}"
                            Laps="{Binding Laps}"
                            SelectedLap="{Binding SelectedLap}" />
                    </controls1:Card>
                    <controls1:Card>
                        <controls:LapStatsControl SelectedLap="{Binding SelectedLap}" />
                    </controls1:Card>
                </StackPanel>

                <StackPanel
                    Grid.Column="0"
                    IsVisible="{Binding ShowComparisonLegend}"
                    Spacing="8">
                    <ItemsControl ItemTemplate="{StaticResource ComparisonLapStatsTemplate}" ItemsSource="{Binding SelectedLaps}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>


                <StackPanel Grid.Column="1" Spacing="8">
                    <controls1:Card>
                        <controls:TrackMapControl Height="400" Series="{Binding TrackData}" />
                    </controls1:Card>

                    <controls1:Card>
                        <controls:ChartControl Subplots="{Binding Subplots}" />
                    </controls1:Card>
                </StackPanel>

            </Grid>
        </ScrollViewer>
    </DockPanel>


</controls:PageView>
