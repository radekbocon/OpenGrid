<UserControl
    x:Class="SimLab.Views.SessionDetailsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:controls="clr-namespace:SimLab.Controls"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:SimLab.ViewModels"
    Padding="16"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:SessionDetailsViewModel"
    mc:Ignorable="d">
    <ScrollViewer>
        <Grid
            x:Name="ChartGrid"
            Margin="0,0,16,0"
            RowDefinitions="Auto, Auto, Auto, Auto, Auto, Auto"
            RowSpacing="4">
            <StackPanel
                Grid.Row="0"
                Margin="8"
                Orientation="Horizontal"
                Spacing="8">
                <TextBlock
                    VerticalAlignment="Center"
                    Classes="Subtitle1"
                    Text="Lap#" />
                <ComboBox
                    DisplayMemberBinding="{Binding Number}"
                    ItemsSource="{Binding Laps}"
                    SelectedItem="{Binding SelectedLap}" />
                <Button
                    Padding="8"
                    Classes="Flat"
                    Command="{Binding CompareWithOtherLapsCommand}"
                    ToolTip.Tip="Compare with other laps">
                    <avalonia:MaterialIcon IconSize="24" Kind="Compare" />
                </Button>
                <Button
                    Padding="8"
                    Classes="Flat"
                    Command="{Binding DeleteLapCommand}"
                    ToolTip.Tip="Delete lap">
                    <avalonia:MaterialIcon IconSize="24" Kind="Delete" />
                </Button>
                <TextBlock
                    VerticalAlignment="Center"
                    Classes="Subtitle1"
                    Classes.InvalidLap="{Binding !SelectedLap?.IsValid}"
                    Text="{Binding LapTime}">
                    <TextBlock.Styles>
                        <Style Selector="TextBlock.InvalidLap">
                            <Setter Property="Foreground" Value="Red" />
                        </Style>
                    </TextBlock.Styles>
                </TextBlock>
                <StackPanel Orientation="Horizontal" Spacing="4">
                    <avalonia:MaterialIcon IconSize="24" Kind="Info" />
                    <TextBlock
                        VerticalAlignment="Center"
                        Classes="Caption"
                        Opacity="0.6"
                        Text="Ctrl+Scroll to zoom, drag to pan the charts"
                        TextAlignment="Center" />
                </StackPanel>
            </StackPanel>

            <controls:ChartControl
                x:Name="InputsChart"
                Title="Inputs"
                Grid.Row="1"
                SeriesSource="{Binding Inputs}"
                YLabeler="{Binding DoubleLabeler}"
                YMaxLimit="1"
                YMinLimit="0" />
            <controls:ChartControl
                x:Name="SteeringChart"
                Title="Steering"
                Grid.Row="2"
                SeriesSource="{Binding Steering}"
                YLabeler="{Binding DoubleLabeler}"
                YMaxLimit="1"
                YMinLimit="-1" />
            <controls:ChartControl
                x:Name="SpeedChart"
                Title="Speed"
                Grid.Row="3"
                SeriesSource="{Binding Speed}"
                YLabeler="{Binding IntegerLabeler}" />
            <controls:ChartControl
                x:Name="GearChart"
                Title="Gear"
                Grid.Row="4"
                SeriesSource="{Binding Gear}"
                YLabeler="{Binding GearLabeler}"
                YMaxLimit="7"
                YMinLimit="0" />
            <controls:ChartControl
                x:Name="RpmChart"
                Title="RPM"
                Grid.Row="5"
                SeriesSource="{Binding Rpm}"
                YLabeler="{Binding IntegerLabeler}"
                YMinLimit="0" />
        </Grid>
    </ScrollViewer>
</UserControl>
