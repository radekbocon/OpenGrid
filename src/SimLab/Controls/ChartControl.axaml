<UserControl
    x:Class="SimLab.Controls.ChartControl"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:sp="clr-namespace:ScottPlot.Avalonia;assembly=ScottPlot.Avalonia"
    x:Name="Root"
    x:CompileBindings="False">
    <Grid>
        <sp:AvaPlot x:Name="ChartElement" />
        <Button
            Margin="4"
            Padding="4"
            HorizontalAlignment="Right"
            VerticalAlignment="Top"
            Classes="Flat"
            Click="ResetZoomClicked"
            ToolTip.Tip="Reset zoom">
            <avalonia:MaterialIcon IconSize="24" Kind="FitToScreen" />
        </Button>
    </Grid>
</UserControl>
