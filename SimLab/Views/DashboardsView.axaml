<UserControl
    x:Class="SimLab.Views.DashboardsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:SimLab.Models"
    xmlns:vm="using:SimLab.ViewModels"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:DashboardsViewModel"
    mc:Ignorable="d">

    <Grid Margin="24" RowDefinitions="Auto, *">
        <TextBlock
            Grid.Row="0"
            Margin="0,0,0,16"
            FontSize="24"
            FontWeight="SemiBold"
            Text="Dashboards" />

        <ItemsControl Grid.Row="1" ItemsSource="{Binding Dashboards}">
            <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                    <WrapPanel />
                </ItemsPanelTemplate>
            </ItemsControl.ItemsPanel>
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="models:DashboardInfo">
                    <Border
                        Width="240"
                        Margin="8"
                        Padding="16"
                        Background="{DynamicResource MaterialCardBackgroundBrush}"
                        CornerRadius="8"
                        Cursor="Hand"
                        PointerPressed="OnDashboardPointerPressed"
                        Tag="{Binding}">
                        <Grid RowDefinitions="Auto, Auto" RowSpacing="8">
                            <TextBlock
                                Grid.Row="0"
                                HorizontalAlignment="Center"
                                FontSize="18"
                                FontWeight="SemiBold"
                                Text="{Binding Name}" />
                            <TextBlock
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                FontSize="13"
                                Opacity="0.7"
                                Text="{Binding Description}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </Grid>
</UserControl>
