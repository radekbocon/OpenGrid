<Application
    x:Class="OpenGrid.App"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:converters="clr-namespace:OpenGrid.Converters"
    xmlns:dialogHostAvalonia="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
    xmlns:local="using:OpenGrid"
    xmlns:themes="clr-namespace:Material.Styles.Themes;assembly=Material.Styles"
    RequestedThemeVariant="Dark">
    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>
    <Application.Resources>
        <converters:LapTimeConverter x:Key="LapTimeConverter" />
    </Application.Resources>

    <Application.Styles>
        <avalonia:MaterialIconStyles />
        <themes:MaterialTheme />
        <dialogHostAvalonia:DialogHostStyles />
        <Style Selector="TextBlock.InvalidLap">
            <Setter Property="Foreground" Value="Red" />
        </Style>
        <Style Selector="TextBlock.FastestLap">
            <Setter Property="Foreground" Value="Green" />
        </Style>
    </Application.Styles>
</Application>