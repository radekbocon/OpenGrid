<UserControl
    x:Class="SimLab.Controls.ChartControl"
    x:Name="Root"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:lvc="using:LiveChartsCore.SkiaSharpView.Avalonia"
    xmlns:vm="clr-namespace:SimLab.ViewModels"
    x:CompileBindings="False">
    <UserControl.Resources>
        <DataTemplate x:Key="ChartLineSeriesTemplate" x:DataType="vm:ChartData">
            <lvc:XamlLineSeries
                Fill="{x:Null}"
                GeometrySize="0"
                LineSmoothness="0"
                SeriesName="{Binding Name}"
                Stroke="{Binding Stroke}"
                Values="{Binding Points}" />
        </DataTemplate>
    </UserControl.Resources>
    <StackPanel Spacing="4">
        <TextBlock Classes="Subtitle1" Text="{Binding Title, ElementName=Root}" />
        <lvc:CartesianChart
            x:Name="ChartElement"
            Height="250"
            AnimationsSpeed="0"
            DrawMargin="{lvc:Margin '70, Auto, Auto, Auto'}"
            SeriesSource="{Binding SeriesSource, ElementName=Root}"
            SeriesTemplate="{StaticResource ChartLineSeriesTemplate}"
            TooltipPosition="Hidden"
            ZoomMode="None">
            <lvc:CartesianChart.XAxes>
                <lvc:XamlAxis
                    CrosshairLabelsBackground="{lvc:Color '#666666'}"
                    CrosshairLabelsPaint="{lvc:SolidColorPaint Color='#EEEEEE'}"
                    CrosshairPaint="{lvc:SolidColorPaint Color='#999999'}"
                    Labeler="{Binding IntegerLabeler}"
                    MaxLimit="{Binding MaxX, Mode=TwoWay}"
                    MinLimit="{Binding MinX, Mode=TwoWay}"
                    PropertyChangedCommand="{Binding ChangeZoomCommand}" />
            </lvc:CartesianChart.XAxes>
            <lvc:CartesianChart.YAxes>
                <lvc:XamlAxis
                    CrosshairLabelsBackground="{lvc:Color '#666666'}"
                    CrosshairLabelsPaint="{lvc:SolidColorPaint Color='#EEEEEE'}"
                    CrosshairPaint="{lvc:SolidColorPaint Color='#999999'}"
                    Labeler="{Binding YLabeler, ElementName=Root}"
                    MaxLimit="{Binding YMaxLimit, ElementName=Root}"
                    MinLimit="{Binding YMinLimit, ElementName=Root}"
                    MinStep="{Binding YMinStep, ElementName=Root}" />
            </lvc:CartesianChart.YAxes>
        </lvc:CartesianChart>
    </StackPanel>
</UserControl>
