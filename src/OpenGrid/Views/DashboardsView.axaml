<controls:PageView
    x:Class="OpenGrid.Views.DashboardsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:controls="clr-namespace:OpenGrid.Controls"
    xmlns:controls1="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:OpenGrid.ViewModels"
    d:DesignHeight="600"
    d:DesignWidth="900"
    x:DataType="vm:DashboardsViewModel"
    mc:Ignorable="d">

    <DockPanel>
        <controls:PageHeader
            Title="Dashboards"
            DockPanel.Dock="Top"
            IsBackButtonVisible="False">
            <Button
                Classes="Flat"
                Command="{Binding RefreshCommand}"
                ToolTip.Tip="Refresh dashboard list">
                <avalonia:MaterialIconExt IconSize="24" Kind="Refresh" />
            </Button>
        </controls:PageHeader>

        <ScrollViewer Padding="0,12,12,0">
            <ItemsControl ItemsSource="{Binding Dashboards}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel ItemSpacing="16" LineSpacing="16" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:DashboardCardViewModel">
                        <controls1:Card
                            Width="240"
                            Padding="0"
                            Background="{DynamicResource MaterialCardBackgroundBrush}"
                            CornerRadius="8">
                            <StackPanel>
                                <!--  Preview image or placeholder  -->
                                <Border
                                    Height="120"
                                    Background="{DynamicResource MaterialTextFieldBoxBackgroundBrush}"
                                    CornerRadius="8,8,0,0">
                                    <Image Source="{Binding Dashboard.Image}" Stretch="UniformToFill" />
                                </Border>

                                <!--  Info  -->
                                <StackPanel Margin="12,8" Spacing="4">
                                    <TextBlock
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Text="{Binding Dashboard.Name}" />
                                    <TextBlock
                                        MaxHeight="36"
                                        FontSize="12"
                                        Opacity="0.6"
                                        Text="{Binding Dashboard.Description}"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <!--  Actions  -->
                                <Border
                                    Padding="8"
                                    BorderBrush="{DynamicResource MaterialCardBorderBrush}"
                                    BorderThickness="0,1,0,0">
                                    <StackPanel Orientation="Horizontal" Spacing="4">
                                        <Button
                                            Padding="8,4"
                                            Classes="Flat"
                                            Command="{Binding OpenInBrowserCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <avalonia:MaterialIconExt IconSize="14" Kind="OpenInNew" />
                                                <TextBlock FontSize="12" Text="Browser" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Padding="8,4"
                                            Classes="Flat"
                                            Command="{Binding ShowOnDeviceCommand}">
                                            <StackPanel Orientation="Horizontal" Spacing="4">
                                                <avalonia:MaterialIconExt IconSize="14" Kind="Devices" />
                                                <TextBlock FontSize="12" Text="Device" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </controls1:Card>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </DockPanel>

</controls:PageView>
