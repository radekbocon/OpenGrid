<Window
    x:Class="SimLab.Views.ConfirmDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="Confirm"
    Width="360"
    Height="180"
    CanResize="False"
    WindowStartupLocation="CenterOwner"
    ShowInTaskbar="False">
    <Grid
        Margin="24"
        RowDefinitions="*, Auto"
        RowSpacing="24">
        <TextBlock
            x:Name="MessageText"
            Grid.Row="0"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            FontSize="15"
            TextWrapping="Wrap"
            TextAlignment="Center" />
        <StackPanel
            Grid.Row="1"
            HorizontalAlignment="Center"
            Orientation="Horizontal"
            Spacing="12">
            <Button
                x:Name="YesButton"
                Content="Yes"
                Width="80"
                Click="YesClick" />
            <Button
                x:Name="NoButton"
                Content="No"
                Width="80"
                Click="NoClick" />
        </StackPanel>
    </Grid>
</Window>
