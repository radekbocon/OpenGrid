<UserControl
    x:Class="OpenGrid.Controls.AddGameDashboardOverrideDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="clr-namespace:OpenGrid.Controls"
    xmlns:models="clr-namespace:OpenGrid.Models"
    x:DataType="local:AddGameDashboardOverrideDialog">
    <Grid
        MinWidth="420"
        Margin="24"
        RowDefinitions="Auto,Auto,Auto,Auto"
        RowSpacing="16">
        <TextBlock Classes="H6" Text="Add Game Override" />
        <Grid
            Grid.Row="1"
            ColumnDefinitions="120,*"
            ColumnSpacing="12">
            <TextBlock VerticalAlignment="Center" Text="Game" />
            <ComboBox
                Grid.Column="1"
                ItemsSource="{Binding Games}"
                SelectedItem="{Binding SelectedGame}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:SteamGame">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>
        <Grid
            Grid.Row="2"
            ColumnDefinitions="120,*"
            ColumnSpacing="12">
            <TextBlock VerticalAlignment="Center" Text="Dashboard" />
            <ComboBox
                Grid.Column="1"
                ItemsSource="{Binding Dashboards}"
                SelectedItem="{Binding SelectedDashboard}">
                <ComboBox.ItemTemplate>
                    <DataTemplate x:DataType="models:DashboardInfo">
                        <TextBlock Text="{Binding Name}" />
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </Grid>
        <StackPanel
            Grid.Row="3"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                Click="CancelClick"
                Content="Cancel"
                Theme="{StaticResource MaterialOutlineButton}" />
            <Button
                x:Name="AddButton"
                Click="AddClick"
                Content="Add"
                IsEnabled="False" />
        </StackPanel>
    </Grid>
</UserControl>
