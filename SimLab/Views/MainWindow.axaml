<Window
    x:Class="SimLab.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SimLab.ViewModels"
    Title="SimLab"
    d:DesignHeight="700"
    d:DesignWidth="1000"
    x:DataType="vm:MainWindowViewModel"
    Icon="/Assets/avalonia-logo.ico"
    mc:Ignorable="d">

    <DockPanel>
        <!--  Top Dock  -->
        <Grid
            Background="{DynamicResource SystemChromeMediumLowColor}"
            ColumnDefinitions="220, *"
            DockPanel.Dock="Top">
            <Grid Grid.Column="0" ColumnDefinitions="Auto, *">
                <Button
                    Margin="4"
                    Click="ToggleSideBar"
                    Content=""
                    FontFamily="{StaticResource Awesome}"
                    FontSize="20" />
                <TextBlock
                    Grid.Column="1"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="20"
                    Text="SimLab" />
            </Grid>

            <StackPanel
                Grid.Column="1"
                Margin="0,8,8,8"
                Orientation="Horizontal"
                Spacing="8">
                <Button
                    Command="{Binding GoBackCommand}"
                    Content=""
                    FontFamily="{StaticResource Awesome}"
                    FontSize="20" />
                <ComboBox
                    DisplayMemberBinding="{Binding Name}"
                    ItemsSource="{Binding SupportedGames}"
                    SelectedItem="{Binding SelectedGame, Mode=TwoWay}" />
                <Button
                    Command="{Binding ConnectCommand}"
                    Content="{Binding ConnectLabel}"
                    IsVisible="{Binding ShowConnectButton}" />
                <Button
                    Command="{Binding DisconnectCommand}"
                    Content="Disconnect"
                    IsVisible="{Binding IsConnected}" />
                <Button
                    Command="{Binding CancelCommand}"
                    Content="Cancel"
                    IsVisible="{Binding IsConnecting}" />
                <TextBlock VerticalAlignment="Center" Text="{Binding TelemetryStatus}" />
            </StackPanel>
        </Grid>

        <!--  Side Bar  -->
        <StackPanel
            Name="SideBar"
            Width="220"
            VerticalAlignment="Stretch"
            Background="{DynamicResource SystemChromeMediumLowColor}"
            DockPanel.Dock="Left">
            <ListBox
                Name="MenuItems"
                VerticalAlignment="Stretch"
                ItemsSource="{Binding MenuItems}"
                SelectedItem="{Binding SelectedMenuItem}">
                <Interaction.Behaviors>
                    <EventTriggerBehavior EventName="SelectionChanged">
                        <InvokeCommandAction Command="{Binding SelectMenuItemCommand}" CommandParameter="{Binding #MenuItems.SelectedItem}" />
                    </EventTriggerBehavior>
                </Interaction.Behaviors>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="vm:MenuItem">
                        <Grid ColumnDefinitions="24,*">
                            <TextBlock
                                Grid.Column="0"
                                FontFamily="{StaticResource Awesome}"
                                FontSize="18"
                                Text="{Binding Icon}" />
                            <TextBlock
                                Grid.Column="1"
                                Margin="8,0,0,0"
                                VerticalAlignment="Center"
                                Text="{Binding Label}" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </StackPanel>

        <!--  Content Area  -->
        <ContentControl Content="{Binding CurrentViewModel}" />
    </DockPanel>
</Window>
