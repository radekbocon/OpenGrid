<UserControl
    x:Class="OpenGrid.Views.MozaDeviceItemView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:controls="clr-namespace:OpenGrid.Controls"
    xmlns:viewModels="clr-namespace:OpenGrid.ViewModels"
    x:DataType="viewModels:MozaDeviceItemViewModel">

    <ScrollViewer HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="16" Spacing="16">
            <TextBlock Classes="Headline6" Text="MOZA Device Details" />

            <Rectangle Height="1" Fill="{DynamicResource MaterialDividerBrush}" />

            <!--  Name  -->
            <Grid ColumnDefinitions="140,*" ColumnSpacing="12">
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Classes="Subtitle1"
                    Opacity="0.6"
                    Text="Name" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Classes="Body1"
                    Text="{Binding Name}" />
            </Grid>

            <!--  Description  -->
            <Grid ColumnDefinitions="140,*" ColumnSpacing="12">
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Classes="Subtitle1"
                    Opacity="0.6"
                    Text="Description" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Classes="Body1"
                    Text="{Binding Description, TargetNullValue='No description'}" />
            </Grid>

            <!--  Status  -->
            <Grid ColumnDefinitions="140,*" ColumnSpacing="12">
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Classes="Subtitle1"
                    Opacity="0.6"
                    Text="Status" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Classes="Body1"
                    Text="{Binding Status}" />
            </Grid>

            <!--  Port  -->
            <Grid ColumnDefinitions="140,*" ColumnSpacing="12">
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Classes="Subtitle1"
                    Opacity="0.6"
                    Text="Serial Port" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Classes="Body2"
                    Text="{Binding PortName}"
                    TextWrapping="Wrap" />
            </Grid>

            <!--  Serial number  -->
            <Grid ColumnDefinitions="140,*" ColumnSpacing="12">
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Classes="Subtitle1"
                    Opacity="0.6"
                    Text="Serial Number" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Classes="Body2"
                    Text="{Binding SerialNumber}"
                    TextWrapping="Wrap" />
            </Grid>

            <!--  Category  -->
            <Grid ColumnDefinitions="140,*" ColumnSpacing="12">
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Classes="Subtitle1"
                    Opacity="0.6"
                    Text="Category" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Classes="Body2"
                    Text="{Binding Category}" />
            </Grid>

            <Rectangle Height="1" Fill="{DynamicResource MaterialDividerBrush}" />

            <TextBlock Classes="Headline6" Text="Configuration" />

            <Rectangle Height="1" Fill="{DynamicResource MaterialDividerBrush}" />

            <!--  Enabled toggle  -->
            <Grid ColumnDefinitions="140,*" ColumnSpacing="12">
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Classes="Subtitle1"
                    Opacity="0.6"
                    Text="Enabled" />
                <ToggleSwitch
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    IsChecked="{Binding IsEnabled}" />
            </Grid>

            <!--  Telemetry LEDs toggle  -->
            <Grid ColumnDefinitions="140,*" ColumnSpacing="12">
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Classes="Subtitle1"
                    Opacity="0.6"
                    Text="Drive Wheel LEDs" />
                <ToggleSwitch
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    IsChecked="{Binding DriveLedsWithTelemetry}" />
            </Grid>

            <TextBlock
                Margin="140,0,0,0"
                Classes="Caption"
                Opacity="0.6"
                Text="LED effects are defined by the preset assigned below."
                TextWrapping="Wrap" />

            <!--  Physical LED count  -->
            <Grid ColumnDefinitions="140,*" ColumnSpacing="12">
                <TextBlock
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Classes="Subtitle1"
                    Opacity="0.6"
                    Text="LEDs per frame" />
                <ComboBox
                    Grid.Column="1"
                    MinWidth="100"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    ItemsSource="{Binding LedCountOptions}"
                    SelectedItem="{Binding LedCount}" />
            </Grid>

            <Border
                Padding="12"
                Background="{DynamicResource MaterialTextFieldBoxBackgroundBrush}"
                BorderBrush="{DynamicResource MaterialValidationErrorBrush}"
                BorderThickness="1"
                CornerRadius="4"
                IsVisible="{Binding HasLedCountMismatch}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <avalonia:MaterialIcon
                        Foreground="{DynamicResource MaterialValidationErrorBrush}"
                        Kind="AlertCircle" />
                    <TextBlock
                        Classes="Body2"
                        Foreground="{DynamicResource MaterialValidationErrorBrush}"
                        Text="{Binding LedCountWarning}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <Rectangle Height="1" Fill="{DynamicResource MaterialDividerBrush}" />

            <TextBlock Classes="Headline6" Text="LED Presets" />

            <controls:DevicePresetSettingsView DataContext="{Binding PresetSettings}" />

        </StackPanel>
    </ScrollViewer>
</UserControl>
