<UserControl
    x:Class="SimLab.Controls.AcTelemetrySetupDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    MinWidth="500"
    MaxHeight="650">
    <Grid RowDefinitions="Auto,*">
        <Border Grid.Row="0" Padding="4">
            <Grid ColumnDefinitions="*,Auto">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="18"
                    FontWeight="SemiBold"
                    Text="Telemetry Bridge Setup" />
                <Button
                    Grid.Column="1"
                    Padding="8"
                    Classes="Flat"
                    Click="CloseClick"
                    Content="{avalonia:MaterialIconExt Kind=Close,
                                                       IconSize=24}" />
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="1" Margin="16,8">
            <StackPanel Spacing="16">
                <TextBlock
                    FontSize="15"
                    FontWeight="SemiBold"
                    Text="SimLab requires protontricks to be installed."
                    TextWrapping="Wrap" />

                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="Why?" />

                <StackPanel Spacing="8">
                    <TextBlock TextWrapping="Wrap">
                        Some games use shared memory for telemetry. When running via Proton, the shared memory lives inside the Proton prefix and is not directly accessible from Linux.
                    </TextBlock>
                    <TextBlock TextWrapping="Wrap">
                        SimLab uses protontricks to launch the telemetry bridge inside the game's Proton prefix. The bridge then copies telemetry to /dev/shm/ so it can be accessed by SimLab.
                    </TextBlock>
                </StackPanel>

                <Rectangle Height="1" Fill="{DynamicResource MaterialDividerBrush}" />

                <TextBlock
                    FontSize="16"
                    FontWeight="SemiBold"
                    Text="Install protontricks" />

                <StackPanel Spacing="8">
                    <TextBlock TextWrapping="Wrap">Arch: sudo pacman -S protontricks</TextBlock>
                    <TextBlock TextWrapping="Wrap">Debian/Ubuntu: sudo apt install protontricks</TextBlock>
                    <TextBlock TextWrapping="Wrap">Fedora: sudo dnf install protontricks</TextBlock>
                </StackPanel>

                <Rectangle Height="1" Fill="{DynamicResource MaterialDividerBrush}" />

                <TextBlock
                    FontSize="13"
                    Foreground="{DynamicResource MaterialBodyBrush}"
                    TextWrapping="Wrap">
                    Once installed, SimLab will automatically use protontricks to launch the telemetry bridge for these games. No additional configuration is needed.
                </TextBlock>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
