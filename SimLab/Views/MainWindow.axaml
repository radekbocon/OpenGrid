<Window
    x:Class="SimLab.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SimLab.ViewModels"
    Title="SimLab - ACC Telemetry"
    d:DesignHeight="700"
    d:DesignWidth="1000"
    x:DataType="vm:MainWindowViewModel"
    Icon="/Assets/avalonia-logo.ico"
    mc:Ignorable="d">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <DockPanel>
        <!--  Connection Bar  -->
        <DockPanel
            Margin="0,0,0,5"
            Background="#2D2D2D"
            DockPanel.Dock="Top">
            <Button
                Width="100"
                Margin="10"
                Padding="5"
                Command="{Binding ConnectCommand}"
                Content="Connect" />
            <TextBlock
                Margin="10"
                VerticalAlignment="Center"
                Foreground="{Binding IsConnected, StringFormat='Connected to ACC'}"
                Text="{Binding ConnectionStatus}" />
        </DockPanel>

        <!--  Main Content  -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="*" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Top Left: Session Info  -->
            <StackPanel
                Grid.Row="0"
                Grid.Column="0"
                Margin="10">
                <TextBlock
                    Margin="0,0,0,10"
                    FontSize="16"
                    FontWeight="Bold"
                    Text="Session Information" />
                <TextBlock Margin="0,5" Text="{Binding CurrentTrack, StringFormat='Track: {0}'}" />
                <TextBlock Margin="0,5" Text="{Binding CurrentSessionType, StringFormat='Session: {0}'}" />
                <TextBlock Margin="0,5" Text="{Binding CurrentLap, StringFormat='Current Lap: {0}'}" />
                <TextBlock
                    Margin="0,10,0,0"
                    Foreground="#FFB700"
                    Text="{Binding ConnectionStatus}" />
            </StackPanel>

            <!--  Top Right: Live Telemetry  -->
            <StackPanel
                Grid.Row="0"
                Grid.Column="1"
                Margin="10">
                <TextBlock
                    Margin="0,0,0,10"
                    FontSize="16"
                    FontWeight="Bold"
                    Text="Live Telemetry" />
                <TextBlock Margin="0,5" Text="{Binding CurrentSpeed, StringFormat='Speed: {0:F1} km/h'}" />
                <TextBlock Margin="0,5" Text="{Binding EngineRpm, StringFormat='RPM: {0:F0}'}" />
                <TextBlock Margin="0,5" Text="{Binding CurrentGear, StringFormat='Gear: {0:F0}'}" />
                <TextBlock Margin="0,5" Text="{Binding FuelRemaining, StringFormat='Fuel: {0:F1} L'}" />
                <ProgressBar
                    Margin="0,10,0,5"
                    Maximum="1"
                    Value="{Binding ThrottleInput}" />
                <ProgressBar
                    Margin="0,5"
                    Foreground="#FF0000"
                    Maximum="1"
                    Value="{Binding BrakeInput}" />
            </StackPanel>

            <!--  Bottom Left: Lap Times  -->
            <StackPanel
                Grid.Row="1"
                Grid.Column="0"
                Margin="10">
                <TextBlock
                    Margin="0,0,0,10"
                    FontSize="16"
                    FontWeight="Bold"
                    Text="Lap Times" />
                <TextBlock Margin="0,5" Text="{Binding BestLapTime, StringFormat='Best: {0}'}" />
                <TextBlock Margin="0,5" Text="{Binding LastLapTime, StringFormat='Last: {0}'}" />
                <TextBlock Margin="0,5" Text="{Binding CurrentLapTime, StringFormat='Current: {0}'}" />
            </StackPanel>

            <!--  Bottom Right: Recent Laps  -->
            <StackPanel
                Grid.Row="1"
                Grid.Column="1"
                Margin="10">
                <TextBlock
                    Margin="0,0,0,10"
                    FontSize="16"
                    FontWeight="Bold"
                    Text="Recent Laps" />
                <DataGrid
                    CanUserReorderColumns="False"
                    CanUserResizeColumns="False"
                    IsReadOnly="True"
                    ItemsSource="{Binding RecentLaps}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding LapNumber}" Header="Lap" />
                        <DataGridTextColumn Binding="{Binding LapTime}" Header="Time" />
                        <DataGridTextColumn Binding="{Binding IsValid}" Header="Valid" />
                    </DataGrid.Columns>
                </DataGrid>
            </StackPanel>
        </Grid>
    </DockPanel>

</Window>
