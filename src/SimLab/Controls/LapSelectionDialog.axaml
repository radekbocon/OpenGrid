<UserControl
    x:Class="SimLab.Controls.LapSelectionDialog"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:controls="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
    xmlns:converters="clr-namespace:SimLab.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:SimLab.ViewModels"
    d:DesignHeight="600"
    d:DesignWidth="600"
    x:DataType="vm:LapSelectionViewModel"
    mc:Ignorable="d">
    <UserControl.Resources>
        <converters:ExpandedToIconConverter x:Key="ExpandedToIconConverter" />
    </UserControl.Resources>
    <Grid
        Margin="16"
        RowDefinitions="Auto, Auto, *, Auto"
        RowSpacing="16"
        MinWidth="500"
        MinHeight="400">
        <TextBlock
            Grid.Row="0"
            Classes="H6"
            Text="Select Laps to Compare" />
        <TextBlock
            Grid.Row="1"
            Classes="Caption"
            Opacity="0.7">
            <TextBlock.Text>
                <MultiBinding StringFormat="Selected: {0} laps (select at least 2)">
                    <Binding Path="SelectedCount" />
                </MultiBinding>
            </TextBlock.Text>
        </TextBlock>
        <ScrollViewer
            Grid.Row="2"
            MaxHeight="350">
            <StackPanel Spacing="8">
                <ItemsControl ItemsSource="{Binding Sessions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:SelectableSession">
                            <controls:Card Margin="0,0,8,0">
                                <Grid RowDefinitions="Auto, Auto">
                                    <ToggleButton
                                        Grid.Row="0"
                                        Classes="Flat"
                                        HorizontalAlignment="Stretch"
                                        IsChecked="{Binding IsExpanded, Mode=TwoWay}">
                                        <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="8">
                                            <avalonia:MaterialIcon
                                                Grid.Column="0"
                                                VerticalAlignment="Center"
                                                Kind="{Binding IsExpanded, Converter={StaticResource ExpandedToIconConverter}}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Text="{Binding DisplayName}" />
                                            <TextBlock
                                                Grid.Column="2"
                                                VerticalAlignment="Center"
                                                Classes="Caption"
                                                Opacity="0.7"
                                                Text="{Binding LapCount, StringFormat='Laps: {0}'}" />
                                        </Grid>
                                    </ToggleButton>
                                    <ItemsControl
                                        Grid.Row="1"
                                        Margin="16,4,0,0"
                                        IsVisible="{Binding IsExpanded}"
                                        ItemsSource="{Binding Laps}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate x:DataType="vm:SelectableLap">
                                                <CheckBox
                                                    Margin="0,2"
                                                    HorizontalAlignment="Stretch"
                                                    IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                                    <Grid ColumnDefinitions="Auto, Auto, *" ColumnSpacing="8">
                                                        <TextBlock
                                                            Grid.Column="0"
                                                            VerticalAlignment="Center"
                                                            Text="{Binding DisplayName}" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            VerticalAlignment="Center"
                                                            Classes="Caption"
                                                            Opacity="0.7"
                                                            Text="(invalid)"
                                                            IsVisible="{Binding !IsValid}" />
                                                    </Grid>
                                                </CheckBox>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </Grid>
                            </controls:Card>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </ScrollViewer>
        <StackPanel
            Grid.Row="3"
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                MinWidth="80"
                Command="{Binding CancelCommand}"
                Content="Cancel"
                Theme="{StaticResource MaterialOutlineButton}" />
            <Button
                MinWidth="80"
                Command="{Binding CompareCommand}"
                Content="Compare" />
        </StackPanel>
    </Grid>
</UserControl>
