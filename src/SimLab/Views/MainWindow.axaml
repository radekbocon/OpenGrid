<Window
    x:Class="SimLab.Views.MainWindow"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:dialogHostAvalonia="clr-namespace:DialogHostAvalonia;assembly=DialogHost.Avalonia"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SimLab.ViewModels"
    Title="SimLab"
    d:DesignHeight="700"
    d:DesignWidth="1000"
    x:DataType="vm:MainWindowViewModel"
    Icon="/Assets/simlab_icon.ico"
    mc:Ignorable="d">

    <dialogHostAvalonia:DialogHost
        Background="{DynamicResource MaterialCardBackgroundBrush}"
        BlurBackground="True"
        OverlayBackground="#90000000">
        <dialogHostAvalonia:DialogHost.DialogContent>
            <ContentPresenter />
        </dialogHostAvalonia:DialogHost.DialogContent>
        <DockPanel>
            <!--  Top Dock  -->
            <Border
                Background="{DynamicResource MaterialTextFieldBoxBackgroundBrush}"
                BorderThickness="0,0,0,2"
                DockPanel.Dock="Top">
                <Grid ColumnDefinitions="220, *">
                    <Grid Grid.Column="0" ColumnDefinitions="Auto, *">
                        <Button
                            Margin="4"
                            Classes="Flat"
                            Click="ToggleSideBar"
                            Content="{avalonia:MaterialIconExt Menu,
                                                               IconSize=24}" />
                        <TextBlock
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Classes="Headline6"
                            Text="SimLab" />
                    </Grid>

                    <StackPanel
                        Grid.Column="1"
                        Margin="0,8,8,8"
                        Orientation="Horizontal"
                        Spacing="8">
                        <Button
                            Padding="8"
                            Classes="Flat"
                            Command="{Binding GoBackCommand}"
                            Content="{avalonia:MaterialIconExt Kind=ChevronLeft,
                                                               IconSize=24}" />
                        <TextBlock VerticalAlignment="Center" Text="{Binding TelemetryStatusText}" />
                        <Button
                            Classes="outline"
                            Command="{Binding StartRecordingCommand}"
                            Content="Start Recording"
                            IsVisible="{Binding CanStartRecording}" />
                        <Button
                            Classes="outline"
                            Command="{Binding StopRecordingCommand}"
                            Content="Stop Recording"
                            IsVisible="{Binding CanStopRecording}" />
                    </StackPanel>
                </Grid>
            </Border>


            <!--  Side Bar  -->
            <StackPanel
                Name="SideBar"
                Width="220"
                VerticalAlignment="Stretch"
                Background="{DynamicResource MaterialTextFieldBoxBackgroundBrush}"
                DockPanel.Dock="Left">
                <ListBox
                    Name="MenuItems"
                    VerticalAlignment="Stretch"
                    ItemsSource="{Binding MenuItems}"
                    SelectedItem="{Binding SelectedMenuItem}">
                    <Interaction.Behaviors>
                        <EventTriggerBehavior EventName="SelectionChanged">
                            <InvokeCommandAction Command="{Binding SelectMenuItemCommand}" CommandParameter="{Binding #MenuItems.SelectedItem}" />
                        </EventTriggerBehavior>
                    </Interaction.Behaviors>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:MenuItem">
                            <Grid Margin="4" ColumnDefinitions="Auto,*">
                                <avalonia:MaterialIcon
                                    Width="24"
                                    Height="24"
                                    Kind="{Binding Icon}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    Classes="Subtitle1"
                                    Text="{Binding Label}" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </StackPanel>

            <!--  Content Area  -->
            <ContentControl Content="{Binding CurrentViewModel}" />
        </DockPanel>
    </dialogHostAvalonia:DialogHost>
</Window>