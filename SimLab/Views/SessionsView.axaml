<UserControl
    x:Class="SimLab.Views.SessionsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="using:SimLab.ViewModels"
    Padding="16"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:SessionsViewModel"
    mc:Ignorable="d">

    <Grid RowDefinitions="Auto, Auto, Auto">
        <StackPanel
            Grid.Row="0"
            Orientation="Horizontal"
            Spacing="8">
            <Button
                Command="{Binding StartSessionCommand}"
                Content="Start Recording"
                IsVisible="{Binding !IsRecording}" />
            <Button
                Command="{Binding StopSessionCommand}"
                Content="Stop Recording"
                IsVisible="{Binding IsRecording}" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{Binding CurrentSession}" />

        <ListBox
            Grid.Row="2"
            DisplayMemberBinding="{Binding Laps.Count}"
            ItemsSource="{Binding Sessions}" />
    </Grid>

</UserControl>
