<UserControl
    x:Class="SimLab.Views.SessionDetailsView"
    xmlns="https://github.com/avaloniaui"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:avalonia="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
    xmlns:controls="clr-namespace:SimLab.Controls"
    xmlns:controls1="clr-namespace:Material.Styles.Controls;assembly=Material.Styles"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:vm="clr-namespace:SimLab.ViewModels"
    Padding="16,16,4,16"
    d:DesignHeight="450"
    d:DesignWidth="800"
    x:DataType="vm:SessionDetailsViewModel"
    mc:Ignorable="d">

    <ScrollViewer>
        <Grid
            Margin="0,0,12,0"
            ColumnDefinitions="Auto, *"
            ColumnSpacing="8"
            RowDefinitions="Auto, *"
            RowSpacing="4">
            <Grid
                Grid.Row="0"
                Grid.ColumnSpan="2"
                ColumnDefinitions="Auto, *"
                ColumnSpacing="8">
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Classes="Subtitle1"
                    Text="{Binding Title}" />
                <StackPanel
                    Grid.Column="1"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
                    <Button
                        Padding="8"
                        Classes="Flat"
                        Command="{Binding CompareWithOtherLapsCommand}"
                        ToolTip.Tip="Compare with other laps">
                        <avalonia:MaterialIcon IconSize="24" Kind="Compare" />
                    </Button>
                    <Button
                        Padding="8"
                        Classes="Flat"
                        Command="{Binding DeleteLapCommand}"
                        ToolTip.Tip="Delete lap">
                        <avalonia:MaterialIcon IconSize="24" Kind="Delete" />
                    </Button>
                </StackPanel>

            </Grid>

            <StackPanel Grid.Row="1" Grid.Column="0">
                <controls1:Card>
                    <controls:LapTableControl Laps="{Binding Laps}" SelectedLap="{Binding SelectedLap}" />
                </controls1:Card>
            </StackPanel>


            <StackPanel
                Grid.Row="1"
                Grid.Column="1"
                Spacing="8">
                <controls1:Card>
                    <controls:TrackMapControl Height="300" Series="{Binding TrackData}" />
                </controls1:Card>

                <controls1:Card>
                    <controls:ChartControl Subplots="{Binding Subplots}" />
                </controls1:Card>
            </StackPanel>

        </Grid>
    </ScrollViewer>
</UserControl>